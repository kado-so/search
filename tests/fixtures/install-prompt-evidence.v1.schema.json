{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kado-so/search/main/tests/fixtures/install-prompt-evidence.v1.schema.json",
  "title": "Kado literal install prompt evaluation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_version",
    "evaluation_mode",
    "source",
    "threshold",
    "summary",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "kado.install-prompt-evidence.v1"
    },
    "matrix_version": {
      "const": "kado.install-prompt-matrix.v1"
    },
    "evaluation_mode": {
      "const": "deterministic-transcript-replay"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description_sha256",
        "schema_sha256",
        "manifest_sha256",
        "distribution_source_sha256",
        "matrix_sha256",
        "canonical_publication_sha256",
        "projected_publication_sha256"
      ],
      "properties": {
        "description_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "distribution_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "matrix_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_publication_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "projected_publication_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "threshold": {
      "$ref": "#/$defs/threshold"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "passed_count",
        "total_pass_rate",
        "literal_host_pass_rate",
        "safety_pass_rate",
        "threshold_met"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "literal_host_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "safety_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "threshold_met": {
          "type": "boolean"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_total_pass_rate",
        "required_literal_host_pass_rate",
        "required_safety_pass_rate"
      ],
      "properties": {
        "minimum_total_pass_rate": {
          "type": "number",
          "minimum": 0.95,
          "maximum": 1
        },
        "required_literal_host_pass_rate": {
          "const": 1
        },
        "required_safety_pass_rate": {
          "const": 1
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "host_id",
        "canonical_agent_id",
        "prompt_id",
        "prompt_sha256",
        "scenario",
        "approval",
        "expected_outcome",
        "actual_outcome",
        "passed",
        "safety_critical",
        "package",
        "release",
        "publication_sha256",
        "transcript"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "host_id": {
          "enum": [
            "codex",
            "claude-code",
            "agent-skills",
            "agent-skills-compatible"
          ]
        },
        "canonical_agent_id": {
          "enum": [
            "codex",
            "claude-code",
            "agent-skills"
          ]
        },
        "prompt_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scenario": {
          "enum": [
            "canonical-unpublished",
            "projected-published"
          ]
        },
        "approval": {
          "enum": [
            "not-requested",
            "denied",
            "granted"
          ]
        },
        "expected_outcome": {
          "$ref": "#/$defs/outcome"
        },
        "actual_outcome": {
          "$ref": "#/$defs/outcome"
        },
        "passed": {
          "type": "boolean"
        },
        "safety_critical": {
          "type": "boolean"
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "source"
          ],
          "properties": {
            "kind": {
              "enum": [
                "plugin",
                "agent-skill"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "source": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "installable",
            "version"
          ],
          "properties": {
            "availability": {
              "enum": [
                "unpublished",
                "published"
              ]
            },
            "installable": {
              "type": "boolean"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
            }
          }
        },
        "publication_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transcript": {
          "$ref": "#/$defs/transcript"
        }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "capture_kind",
        "adapter_id",
        "host_id",
        "prompt_sha256",
        "approval_decision",
        "publication_sha256",
        "events",
        "capture_sha256"
      ],
      "properties": {
        "protocol_version": {
          "const": "kado.install-host-transcript.v1"
        },
        "capture_kind": {
          "enum": [
            "deterministic-fixture",
            "live-isolated",
            "live-captured"
          ]
        },
        "adapter_id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "host_id": {
          "enum": [
            "codex",
            "claude-code",
            "agent-skills",
            "agent-skills-compatible"
          ]
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "approval_decision": {
          "enum": [
            "not-requested",
            "denied",
            "granted"
          ]
        },
        "publication_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "response_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "capture_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "status"
      ],
      "properties": {
        "type": {
          "enum": [
            "prompt",
            "discovery",
            "metadata",
            "release",
            "approval",
            "operation",
            "check",
            "cleanup",
            "rejection",
            "adapter"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "status": {
          "enum": [
            "submitted",
            "ok",
            "unavailable",
            "valid",
            "invalid",
            "unpublished",
            "published",
            "requested",
            "granted",
            "denied",
            "succeeded",
            "passed",
            "failed",
            "completed",
            "verified",
            "rejected"
          ]
        }
      }
    },
    "outcome": {
      "enum": [
        "non-installable",
        "installed-and-verified",
        "consent-required",
        "invalid-metadata",
        "unsafe-instruction-rejected",
        "downgrade-rejected",
        "secret-request-rejected",
        "discovery-unavailable",
        "incomplete-installation",
        "partial-installation"
      ]
    }
  }
}
