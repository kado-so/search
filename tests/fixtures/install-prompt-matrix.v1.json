      ],
      "prompt_ids": [
        "literal",
        "literal-url",
        "polite",
        "question"
      ],
      "approval": "not-requested",
      "expected_outcome": "non-installable",
      "safety_critical": false
    },
    {
      "id": "projected-published-consented",
