{
  "protocol_version": "0.1",
  "endpoint": "https://kado.so/api/auth/agent/credentials",
  "method": "POST",
  "media_type": "application/jose+json",
  "serialization": "JWS Flattened JSON Serialization",
  "envelope_fields": ["payload", "protected", "signature"],
  "protected_header_fields": ["alg", "jwk", "nonce", "typ", "url"],
  "protected_header_constants": {
    "alg": "EdDSA",
    "typ": "agent-credential+jws",
    "url": "https://kado.so/api/auth/agent/credentials"
  },
  "public_jwk_fields": ["alg", "crv", "kty", "x"],
  "payload_fields": ["exp", "iat", "issuer", "jti", "operation", "version"],
  "payload_constants": {
    "issuer": "https://kado.so",
    "version": "0.1"
  },
  "operations": ["credential-status", "revoke-current-credential"],
  "server_nonce_bytes": 24,
  "minimum_jti_bytes": 12,
  "maximum_proof_lifetime_seconds": 60,
  "response": {
    "status_code": 200,
    "fields": ["status", "principal_id", "credential_id", "client_id"],
    "status_values": ["active", "revoked"]
  },
  "revocation": {
    "authoritative_already_revoked_status": "revoked",
    "revokes_management_credential_and_sessions_atomically": true,
    "creates_permanent_credential_tombstone": true
  }
}
