{
  "protocol_version": "0.1",
  "session_authorization": {
    "completion_response_fields": [
      "status",
      "created",
      "principal_id",
      "credential_id",
      "client_id",
      "token_endpoint",
      "token_endpoint_auth_method",
      "session_id",
      "session_credential_id",
      "session_expires_at",
      "resource",
      "granted_scopes"
    ],
    "constants": {
      "status": "active",
      "resource": "https://kado.so",
      "token_endpoint": "https://kado.so/oauth/token",
      "token_endpoint_auth_method": "private_key_jwt"
    },
    "session_mode": "autonomous",
    "session_private_material_returned_or_stored": false
  },
  "token_request": {
    "endpoint": "https://kado.so/oauth/token",
    "media_type": "application/x-www-form-urlencoded",
    "fields": [
      "client_assertion",
      "client_assertion_type",
      "client_id",
      "grant_type",
      "resource",
      "scope"
    ],
    "constants": {
      "grant_type": "client_credentials",
      "client_assertion_type": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer",
      "resource": "https://kado.so"
    }
  },
  "client_assertion": {
    "serialization": "JWT Compact Serialization",
    "protected_header_fields": ["alg", "kid", "typ"],
    "protected_header_constants": {
      "alg": "EdDSA",
      "typ": "JWT"
    },
    "kid_identifier_prefix": "scred_",
    "claim_fields": ["aud", "exp", "iat", "iss", "jti", "sub"],
    "claim_rules": {
      "iss_and_sub": "exact OAuth client_id",
      "aud": "https://kado.so/oauth/token",
      "maximum_lifetime_seconds": 60,
      "minimum_jti_random_bytes": 12
    }
  },
  "token_response": {
    "fields": ["access_token", "token_type", "expires_in", "scope"],
    "constants": {
      "token_type": "Bearer"
    },
    "refresh_token_issued": false
  },
  "access_token": {
    "serialization": "JWT Compact Serialization",
    "protected_header_fields": ["alg", "kid", "typ"],
    "protected_header_constants": {
      "alg": "EdDSA",
      "typ": "at+jwt"
    },
    "claim_fields": [
      "iss",
      "sub",
      "aud",
      "client_id",
      "principal_type",
      "agent_session_id",
      "session_mode",
      "scope",
      "iat",
      "nbf",
      "exp",
      "jti"
    ],
    "claim_constants": {
      "iss": "https://kado.so",
      "aud": "https://kado.so",
      "principal_type": "agent",
      "session_mode": "autonomous"
    },
    "maximum_lifetime_seconds": 300,
    "maximum_clock_skew_seconds": 30,
    "not_before_rule": "nbf equals iat"
  },
  "jwks": {
    "endpoint": "https://kado.so/.well-known/jwks.json",
    "document_fields": ["keys"],
    "public_jwk_fields": ["alg", "crv", "kid", "kty", "use", "x"],
    "public_jwk_constants": {
      "alg": "EdDSA",
      "crv": "Ed25519",
      "kty": "OKP",
      "use": "sig"
    },
    "ordering": "active signing key first, then scheduled previous public keys whose not_after has not passed",
    "previous_key_schedule_fields": ["activated_at", "jwk", "not_after", "retired_at"],
    "previous_key_schedule_ordering": "newest first; each retired_at equals the next key activated_at",
    "schedule_metadata_exposed_in_jwks": false,
    "expired_previous_keys_omitted": true,
    "minimum_previous_key_overlap_seconds": 360,
    "private_members_permitted": false
  }
}
