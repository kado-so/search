{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kado-so/search/blob/main/distribution/kado-search.manifest.schema.json",
  "title": "Kado Search distribution manifest source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin",
    "skill",
    "marketplaces",
    "installation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plugin": {
      "$ref": "#/$defs/plugin"
    },
    "skill": {
      "$ref": "#/$defs/skill"
    },
    "marketplaces": {
      "$ref": "#/$defs/marketplaces"
    },
    "installation": {
      "$ref": "#/$defs/installation"
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "display_name",
        "description",
        "short_description",
        "long_description",
        "developer_name",
        "category",
        "capabilities",
        "homepage",
        "website",
        "repository",
        "license",
        "keywords",
        "brand_color",
        "default_prompt"
      ],
      "properties": {
        "id": {
          "const": "kado-search"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "long_description": {
          "type": "string",
          "minLength": 1
        },
        "developer_name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "homepage": {
          "$ref": "#/$defs/httpsUrl"
        },
        "website": {
          "$ref": "#/$defs/httpsUrl"
        },
        "repository": {
          "const": "https://github.com/kado-so/search"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "brand_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "default_prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "description",
        "compatibility",
        "implicit_invocation",
        "icon_small",
        "icon_large"
      ],
      "properties": {
        "path": {
          "const": "skills/kado-search"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "compatibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "implicit_invocation": {
          "const": true
        },
        "icon_small": {
          "type": "string",
          "minLength": 1
        },
        "icon_large": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "marketplaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex",
        "claude"
      ],
      "properties": {
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "display_name",
            "source_path",
            "installation",
            "authentication"
          ],
          "properties": {
            "name": {
              "const": "kado"
            },
            "display_name": {
              "type": "string",
              "minLength": 1
            },
            "source_path": {
              "const": "./"
            },
            "installation": {
              "enum": [
                "NOT_AVAILABLE",
                "AVAILABLE",
                "INSTALLED_BY_DEFAULT"
              ]
            },
            "authentication": {
              "enum": [
                "ON_INSTALL",
                "ON_USE"
              ]
            }
          }
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "description",
            "source_path"
          ],
          "properties": {
            "name": {
              "const": "kado"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "source_path": {
              "const": "./"
            }
          }
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli_executable",
        "cli_install_url",
        "source"
      ],
      "properties": {
        "cli_executable": {
          "const": "kado"
        },
        "cli_install_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "repository"
          ],
          "properties": {
            "kind": {
              "const": "github"
            },
            "repository": {
              "const": "kado-so/search"
            }
          }
        }
      }
    }
  }
}
