{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kado-so/search/main/distribution/kado-installation.v1.schema.json",
  "title": "Kado installation description v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "product",
    "approval",
    "capabilities",
    "supported_agents",
    "supported_platforms",
    "release",
    "cli",
    "service",
    "source_integrity"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/kado-so/search/main/distribution/kado-installation.v1.schema.json"
    },
    "schema_version": {
      "const": "kado.installation.v1"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "executable",
        "website_url",
        "install_url",
        "repository_url",
        "description_url",
        "description_manifest_url"
      ],
      "properties": {
        "id": {
          "const": "kado-search"
        },
        "name": {
          "const": "Kado Search"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "executable": {
          "const": "kado"
        },
        "website_url": {
          "const": "https://kado.so"
        },
        "install_url": {
          "const": "https://kado.so/install"
        },
        "repository_url": {
          "const": "https://github.com/kado-so/search"
        },
        "description_url": {
          "const": "https://raw.githubusercontent.com/kado-so/search/main/distribution/kado-installation.v1.gen.json"
        },
        "description_manifest_url": {
          "const": "https://raw.githubusercontent.com/kado-so/search/main/distribution/kado-installation.v1.manifest.gen.json"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "kind",
        "applies_to",
        "agent_behavior"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "kind": {
          "const": "explicit-user-confirmation"
        },
        "applies_to": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "cli-install",
              "plugin-or-skill-install",
              "update-or-uninstall"
            ]
          }
        },
        "agent_behavior": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "supported_agents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/agent"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "agent-skills"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "codex"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "claude-code"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "supported_platforms": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/platform"
      },
      "allOf": [
        {
          "contains": {
            "const": {
              "os": "darwin",
              "arch": "amd64",
              "archive_format": "tar.gz",
              "executable": "kado"
            }
          }
        },
        {
          "contains": {
            "const": {
              "os": "darwin",
              "arch": "arm64",
              "archive_format": "tar.gz",
              "executable": "kado"
            }
          }
        },
        {
          "contains": {
            "const": {
              "os": "linux",
              "arch": "amd64",
              "archive_format": "tar.gz",
              "executable": "kado"
            }
          }
        },
        {
          "contains": {
            "const": {
              "os": "linux",
              "arch": "arm64",
              "archive_format": "tar.gz",
              "executable": "kado"
            }
          }
        },
        {
          "contains": {
            "const": {
              "os": "windows",
              "arch": "amd64",
              "archive_format": "zip",
              "executable": "kado.exe"
            }
          }
        },
        {
          "contains": {
            "const": {
              "os": "windows",
              "arch": "arm64",
              "archive_format": "zip",
              "executable": "kado.exe"
            }
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "installable",
        "metadata_schema_version",
        "metadata_url",
        "signature_url",
        "publication_requirement",
        "asset_discovery",
        "verification_discovery"
      ],
      "properties": {
        "availability": {
          "const": "unpublished"
        },
        "installable": {
          "const": false
        },
        "metadata_schema_version": {
          "const": "kado.release.v1"
        },
        "metadata_url": {
          "const": "https://kado.so/install/releases/stable/release-metadata.json"
        },
        "signature_url": {
          "const": "https://kado.so/install/releases/stable/release-metadata.json.sig"
        },
        "publication_requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "asset_discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binary",
            "archive",
            "install_guide",
            "install_unix",
            "install_powershell",
            "uninstall_unix",
            "uninstall_powershell"
          ],
          "properties": {
            "binary": {
              "const": "targets[].binary"
            },
            "archive": {
              "const": "targets[].archive"
            },
            "install_guide": {
              "const": "install_guide"
            },
            "install_unix": {
              "const": "install_unix"
            },
            "install_powershell": {
              "const": "install_powershell"
            },
            "uninstall_unix": {
              "const": "uninstall_unix"
            },
            "uninstall_powershell": {
              "const": "uninstall_powershell"
            }
          }
        },
        "verification_discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "public_key",
            "signature",
            "checksums",
            "provenance",
            "sbom"
          ],
          "properties": {
            "public_key": {
              "$ref": "#/$defs/discovery"
            },
            "signature": {
              "$ref": "#/$defs/discovery"
            },
            "checksums": {
              "$ref": "#/$defs/discovery"
            },
            "provenance": {
              "$ref": "#/$defs/discovery"
            },
            "sbom": {
              "$ref": "#/$defs/discovery"
            }
          }
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install",
        "update",
        "uninstall"
      ],
      "properties": {
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "available_when",
            "steps",
            "forbidden"
          ],
          "properties": {
            "mode": {
              "const": "verified-local-release-bundle"
            },
            "available_when": {
              "const": "signed-release-metadata-is-published"
            },
            "steps": {
              "$ref": "#/$defs/instructions"
            },
            "forbidden": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "curl-pipe-shell",
                  "unverified-binary",
                  "overwrite-existing-binary"
                ]
              }
            }
          }
        },
        "update": {
          "$ref": "#/$defs/cliOperation"
        },
        "uninstall": {
          "$ref": "#/$defs/cliOperation"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected_search",
        "search_document",
        "authentication"
      ],
      "properties": {
        "protected_search": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "method",
            "query_parameter",
            "authentication_required",
            "media_type"
          ],
          "properties": {
            "url": {
              "const": "https://kado.so/search"
            },
            "method": {
              "const": "GET"
            },
            "query_parameter": {
              "const": "q"
            },
            "authentication_required": {
              "const": true
            },
            "media_type": {
              "const": "application/vnd.kado.search.v1+json"
            }
          }
        },
        "search_document": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "manifest_url",
            "schema_url",
            "context_url",
            "openapi_url"
          ],
          "properties": {
            "schema_version": {
              "const": "kado.search-document.v1"
            },
            "manifest_url": {
              "const": "https://kado.so/contracts/search-document/v1/manifest.json"
            },
            "schema_url": {
              "const": "https://kado.so/schemas/search-document/v1.json"
            },
            "context_url": {
              "const": "https://kado.so/contexts/search-document/v1.jsonld"
            },
            "openapi_url": {
              "const": "https://kado.so/openapi/search-document/v1.json"
            }
          }
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorization_server_metadata_url",
            "protected_resource_metadata_url",
            "agent_principal_metadata_url",
            "jwks_url"
          ],
          "properties": {
            "authorization_server_metadata_url": {
              "const": "https://kado.so/.well-known/oauth-authorization-server"
            },
            "protected_resource_metadata_url": {
              "const": "https://kado.so/.well-known/oauth-protected-resource"
            },
            "agent_principal_metadata_url": {
              "const": "https://kado.so/.well-known/agent-principal"
            },
            "jwks_url": {
              "const": "https://kado.so/.well-known/jwks.json"
            }
          }
        }
      }
    },
    "source_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "distribution_source",
        "schema"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "distribution_source": {
          "$ref": "#/$defs/sourceArtifact"
        },
        "schema": {
          "$ref": "#/$defs/sourceArtifact"
        }
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "semver": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "command": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^(?:--[a-z][a-z-]*|[A-Za-z0-9][A-Za-z0-9@._/+~-]*)$"
      }
    },
    "commandStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "command"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "command": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "package_kind",
        "package_id",
        "package_url",
        "manifest_urls",
        "install_steps",
        "uninstall_steps",
        "skill_invocation"
      ],
      "properties": {
        "id": {
          "enum": [
            "agent-skills",
            "codex",
            "claude-code"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "package_kind": {
          "enum": [
            "agent-skill",
            "plugin"
          ]
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "package_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "manifest_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/httpsUrl"
          }
        },
        "install_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/commandStep"
          }
        },
        "uninstall_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/commandStep"
          }
        },
        "skill_invocation": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "agent-skills"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "display_name": {
                "const": "Agent Skills"
              },
              "package_kind": {
                "const": "agent-skill"
              },
              "package_id": {
                "const": "kado-search"
              },
              "package_url": {
                "const": "https://github.com/kado-so/search/tree/main/skills/kado-search"
              },
              "manifest_urls": {
                "const": [
                  "https://raw.githubusercontent.com/kado-so/search/main/skills/kado-search/SKILL.md"
                ]
              },
              "install_steps": {
                "const": [
                  {
                    "operation": "install",
                    "command": [
                      "npx",
                      "skills",
                      "add",
                      "kado-so/search",
                      "--skill",
                      "kado-search"
                    ]
                  }
                ]
              },
              "uninstall_steps": {
                "const": [
                  {
                    "operation": "uninstall",
                    "command": [
                      "npx",
                      "skills",
                      "remove",
                      "kado-search"
                    ]
                  }
                ]
              },
              "skill_invocation": {
                "const": "kado-search"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "codex"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "display_name": {
                "const": "Codex"
              },
              "package_kind": {
                "const": "plugin"
              },
              "package_id": {
                "const": "kado-search@kado"
              },
              "package_url": {
                "const": "https://github.com/kado-so/search"
              },
              "manifest_urls": {
                "const": [
                  "https://raw.githubusercontent.com/kado-so/search/main/.agents/plugins/marketplace.json",
                  "https://raw.githubusercontent.com/kado-so/search/main/.codex-plugin/plugin.json",
                  "https://raw.githubusercontent.com/kado-so/search/main/skills/kado-search/SKILL.md"
                ]
              },
              "install_steps": {
                "const": [
                  {
                    "operation": "marketplace_add",
                    "command": [
                      "codex",
                      "plugin",
                      "marketplace",
                      "add",
                      "kado-so/search"
                    ]
                  },
                  {
                    "operation": "install",
                    "command": [
                      "codex",
                      "plugin",
                      "add",
                      "kado-search@kado"
                    ]
                  }
                ]
              },
              "uninstall_steps": {
                "const": [
                  {
                    "operation": "uninstall",
                    "command": [
                      "codex",
                      "plugin",
                      "remove",
                      "kado-search@kado"
                    ]
                  },
                  {
                    "operation": "marketplace_remove",
                    "command": [
                      "codex",
                      "plugin",
                      "marketplace",
                      "remove",
                      "kado"
                    ]
                  }
                ]
              },
              "skill_invocation": {
                "const": "kado-search:kado-search"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "claude-code"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "display_name": {
                "const": "Claude Code"
              },
              "package_kind": {
                "const": "plugin"
              },
              "package_id": {
                "const": "kado-search@kado"
              },
              "package_url": {
                "const": "https://github.com/kado-so/search"
              },
              "manifest_urls": {
                "const": [
                  "https://raw.githubusercontent.com/kado-so/search/main/.claude-plugin/marketplace.json",
                  "https://raw.githubusercontent.com/kado-so/search/main/.claude-plugin/plugin.json",
                  "https://raw.githubusercontent.com/kado-so/search/main/skills/kado-search/SKILL.md"
                ]
              },
              "install_steps": {
                "const": [
                  {
                    "operation": "marketplace_add",
                    "command": [
                      "claude",
                      "plugin",
                      "marketplace",
                      "add",
                      "kado-so/search"
                    ]
                  },
                  {
                    "operation": "install",
                    "command": [
                      "claude",
                      "plugin",
                      "install",
                      "kado-search@kado"
                    ]
                  }
                ]
              },
              "uninstall_steps": {
                "const": [
                  {
                    "operation": "uninstall",
                    "command": [
                      "claude",
                      "plugin",
                      "uninstall",
                      "kado-search@kado"
                    ]
                  },
                  {
                    "operation": "marketplace_remove",
                    "command": [
                      "claude",
                      "plugin",
                      "marketplace",
                      "remove",
                      "kado"
                    ]
                  }
                ]
              },
              "skill_invocation": {
                "const": "/kado-search:kado-search"
              }
            }
          }
        }
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "archive_format",
        "executable"
      ],
      "properties": {
        "os": {
          "enum": [
            "darwin",
            "linux",
            "windows"
          ]
        },
        "arch": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "archive_format": {
          "enum": [
            "tar.gz",
            "zip"
          ]
        },
        "executable": {
          "enum": [
            "kado",
            "kado.exe"
          ]
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "format"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "cliOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "approval_required",
        "behavior"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/command"
        },
        "dry_run_command": {
          "$ref": "#/$defs/command"
        },
        "approval_required": {
          "const": true
        },
        "behavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "size"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
